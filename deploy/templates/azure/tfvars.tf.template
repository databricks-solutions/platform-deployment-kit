# Generated variables for the Databricks Azure deployment.
# Keep the Databricks account ID outside this file:
# export TF_VAR_databricks_account_id="<your-account-id>"

{{#if enable_private_link}}
# Azure Back-end Private Link (classic)
resource_prefix = "{{project_prefix}}"
workspace_name = "{{azure_workspace_name}}"
root_storage_name = "{{azure_root_storage_name}}"
managed_resource_group_name = "{{azure_managed_resource_group_name}}"
azure_subscription_id = "{{azure_subscription_id}}"
databricks_account_id = "{{azure_databricks_account_id}}"
location = "{{azure_location}}"
create_resource_group = {{azure_create_resource_group}}
resource_group_name = "{{resource_group_name}}"

create_new_vnet = {{create_new_vpc}}
vnet_name = "{{azure_vnet_name}}"
vnet_resource_group_name = "{{azure_vnet_resource_group_name}}"
vnet_cidr = "{{vpc_cidr}}"

subnet_public_cidr = "{{azure_public_subnet_cidr}}"
subnet_private_cidr = "{{azure_private_subnet_cidr}}"
subnet_private_endpoint_cidr = "{{azure_private_endpoint_subnet_cidr}}"

create_nat_gateway = {{enable_nat_gateway}}
nat_gateway_zones = {{{azure_private_link_nat_gateway_zones}}}

# Add full Azure resource IDs here when cluster nodes must reach customer-managed
# storage through the Microsoft.Storage service endpoint policy.
service_endpoint_policy_storage_accounts = []

# Unity Catalog Private Link deployment. This creates or assigns a metastore,
# then creates the dedicated ADLS storage, credential, external location, and catalog.
metastore_id = "{{metastore_id}}"
new_metastore_name = "{{metastore_name}}"
admin_user = "{{azure_admin_user}}"
new_catalog = {{create_catalog}}
uc_storage_account_name = "{{azure_uc_storage_account_name}}"
uc_container_name = "{{azure_uc_container_name}}"
catalog_name = "{{azure_catalog_name}}"
storage_credential_name = "{{azure_storage_credential_name}}"
external_location_name = "{{azure_external_location_name}}"
create_cluster = {{azure_create_cluster}}
node_type_id = "{{azure_node_type_id}}"
cluster_autotermination_minutes = {{cluster_autotermination_minutes}}
tags = {{{common_tags}}}
{{else}}
# Azure VNet injection with Unity Catalog
azure_subscription_id = "{{azure_subscription_id}}"
databricks_account_id = "{{azure_databricks_account_id}}"
create_resource_group  = {{azure_create_resource_group}}
resource_group_name   = "{{resource_group_name}}"
location              = "{{azure_location}}"
tags = {{{common_tags}}}

resource_prefix             = "{{project_prefix}}"
workspace_name              = "{{azure_workspace_name}}"
admin_user                  = "{{azure_admin_user}}"
root_storage_name           = "{{azure_root_storage_name}}"
managed_resource_group_name = "{{azure_managed_resource_group_name}}"

metastore_id           = "{{metastore_id}}"
new_metastore_name     = "{{metastore_name}}"

uc_storage_account_name = "{{azure_uc_storage_account_name}}"
uc_container_name        = "{{azure_uc_container_name}}"
catalog_name              = "{{azure_catalog_name}}"
storage_credential_name   = "{{azure_storage_credential_name}}"
external_location_name    = "{{azure_external_location_name}}"
new_catalog               = {{create_catalog}}

create_cluster = {{azure_create_cluster}}
node_type_id = "{{azure_node_type_id}}"
cluster_autotermination_minutes = {{cluster_autotermination_minutes}}

create_new_vnet          = {{create_new_vpc}}
vnet_name                = "{{azure_vnet_name}}"
vnet_resource_group_name = "{{azure_vnet_resource_group_name}}"
vnet_cidr                = "{{vpc_cidr}}"
nat_gateway_zones        = {{{azure_nat_gateway_zones}}}
subnet_public_cidr       = "{{azure_public_subnet_cidr}}"
subnet_private_cidr      = "{{azure_private_subnet_cidr}}"
{{/if}}

# ============================================================================
# Terraform Variables File (terraform.tfvars)
# ============================================================================
#
# PURPOSE:
#   This file provides default values for all variables.
#
# ============================================================================

# ----------------------------------------------------------------------------
# BASIC CONFIGURATION
# ----------------------------------------------------------------------------

aws_region     = "{{region}}"
project_prefix = "{{project_prefix}}"

# ----------------------------------------------------------------------------
# VPC CONFIGURATION
# ----------------------------------------------------------------------------

vpc_cidr       = "{{vpc_cidr}}"
create_new_vpc = {{create_new_vpc}}
{{#unless create_new_vpc}}
existing_vpc_id = "{{existing_vpc_id}}"
{{/unless}}

# Existing network configuration (only used when create_new_vpc = false)
{{#if existing_subnet_ids}}
existing_subnet_ids = {{{existing_subnet_ids}}}
{{/if}}
{{#if existing_security_group_ids}}
existing_security_group_ids = {{{existing_security_group_ids}}}
{{/if}}

{{#if availability_zones}}
availability_zones = {{{availability_zones}}}
{{/if}}

{{#if calculated_subnets}}
# Subnet CIDRs (only used when creating new subnets)
{{#each calculated_subnets}}
{{name_replace}}_subnet_cidr = "{{cidr}}"
{{/each}}
{{/if}}

# ----------------------------------------------------------------------------
# DATABRICKS CONFIGURATION
# ----------------------------------------------------------------------------

# IMPORTANT: Uncomment and set your Databricks account ID (REQUIRED)
# Find it at: Databricks Account Console > Settings > Account ID
# You can also use environment variable: export TF_VAR_databricks_account_id="your-id"
# databricks_account_id = ""

pricing_tier   = "{{pricing_tier}}"
workspace_name = "{{project_prefix}}"

# ----------------------------------------------------------------------------
# SECURITY CONFIGURATION
# ----------------------------------------------------------------------------

enable_private_link = {{enable_private_link}}
{{#if enable_private_link}}
privatelink_subnet_mode        = "{{privatelink_subnet_mode}}"
existing_privatelink_subnet_id = "{{existing_privatelink_subnet_id}}"
{{/if}}
{{#if cross_account_role_arn}}
cross_account_role_arn = "{{cross_account_role_arn}}"
{{/if}}

# ----------------------------------------------------------------------------
# ADVANCED CONFIGURATION
# ----------------------------------------------------------------------------

nat_gateway_mode     = "{{nat_gateway_mode}}"
enable_vpc_endpoints = true

# ----------------------------------------------------------------------------
# TAGS
# ----------------------------------------------------------------------------

common_tags = {
  Project     = "{{project_prefix}}"
  Environment = "dev"
  ManagedBy   = "terraform"
  Provider    = "aws"
  CreatedBy   = "oneclick-databricks-deployer"
}

# ============================================================================
# AWS Main Terraform Configuration
# ============================================================================
# Deploys Databricks workspace on AWS with VPC, IAM, S3, and networking.
# ============================================================================

# ----------------------------------------------------------------------------
# DATA SOURCES
# ----------------------------------------------------------------------------

# Current AWS account information
data "aws_caller_identity" "current" {}

# AWS partition (aws, aws-cn, aws-us-gov)
data "aws_partition" "current" {}

# Available AZs in the region
data "aws_availability_zones" "available" {
  state = "available"
  filter {
    name   = "opt-in-status"
    values = ["opt-in-not-required"]
  }
}

# ----------------------------------------------------------------------------
# DATABRICKS IAM POLICIES
# ----------------------------------------------------------------------------
# Required policies for Databricks cross-account access

# Policy allowing Databricks to assume the IAM role
data "databricks_aws_assume_role_policy" "this" {
  external_id = var.databricks_account_id
}

# Cross-account policy with required Databricks permissions
data "databricks_aws_crossaccount_policy" "this" {}

# ----------------------------------------------------------------------------
# VPC
# ----------------------------------------------------------------------------

# Virtual Private Cloud for Databricks resources
resource "aws_vpc" "this" {
  count = var.create_new_vpc ? 1 : 0
  
  cidr_block           = var.vpc_cidr
  enable_dns_hostnames = true
  enable_dns_support   = true
  
  tags = merge(var.common_tags, {
    Name = "${var.project_prefix}-vpc"
  })
}

# Internet Gateway for public internet access
resource "aws_internet_gateway" "this" {
  count = var.create_new_vpc ? 1 : 0
  
  vpc_id = aws_vpc.this[0].id
  
  tags = merge(var.common_tags, {
    Name = "${var.project_prefix}-igw"
  })
}

# ----------------------------------------------------------------------------
# LOCAL VALUES
# ----------------------------------------------------------------------------

locals {
  # VPC ID (new or existing)
  vpc_id = var.create_new_vpc ? aws_vpc.this[0].id : var.existing_vpc_id
  
  # Whether to create network resources (subnets, security groups)
  create_network_resources = var.create_new_vpc || var.create_new_subnets
  
  # Private subnet IDs for Databricks clusters
  # Uses created subnets when create_network_resources is true, otherwise uses existing subnet IDs
  databricks_subnet_ids = local.create_network_resources ? [
    {{#each calculated_subnets}}
    {{#if is_private}}
    aws_subnet.{{name_replace}}[0].id{{#unless @last}},{{/unless}}
    {{/if}}
    {{/each}}
  ] : var.existing_subnet_ids
  
  # All subnet IDs for network configuration
  all_subnet_ids = local.create_network_resources ? [
    {{#each calculated_subnets}}
    aws_subnet.{{name_replace}}[0].id{{#unless @last}},{{/unless}}
    {{/each}}
  ] : var.existing_subnet_ids
  
  # Security group IDs - created or existing
  security_group_ids = local.create_network_resources ? [
    aws_security_group.databricks[0].id
  ] : var.existing_security_group_ids
}

# ----------------------------------------------------------------------------
# SUBNETS
# ----------------------------------------------------------------------------
# Subnets are created when creating a new VPC OR when creating new subnets in an existing VPC

{{#each calculated_subnets}}
# {{name}} subnet in {{availability_zone}}
resource "aws_subnet" "{{name_replace}}" {
  count = local.create_network_resources ? 1 : 0
  
  vpc_id                  = local.vpc_id
  cidr_block              = var.{{name_replace}}_subnet_cidr
  availability_zone       = "{{availability_zone}}"
  map_public_ip_on_launch = {{is_public}}
  
  tags = merge(var.common_tags, {
    Name = "${var.project_prefix}-{{name}}"
  })
}

{{/each}}
# ----------------------------------------------------------------------------
# SECURITY GROUP
# ----------------------------------------------------------------------------
# Security group is created when creating network resources (new VPC or new subnets)

# Security group for Databricks cluster nodes
resource "aws_security_group" "databricks" {
  count = local.create_network_resources ? 1 : 0
  
  name        = "${var.project_prefix}-databricks-sg"
  description = "Security group for Databricks workspace"
  vpc_id      = local.vpc_id
  
  # Allow all traffic between cluster nodes
  ingress {
    description = "Allow all internal traffic"
    from_port   = 0
    to_port     = 0
    protocol    = "-1"
    self        = true
  }
  
  # Allow outbound internet access
  egress {
    description = "Allow all outbound traffic"
    from_port   = 0
    to_port     = 0
    protocol    = "-1"
    cidr_blocks = ["0.0.0.0/0"]
  }
  
  tags = merge(var.common_tags, {
    Name = "${var.project_prefix}-databricks-sg"
  })
  
  lifecycle {
    create_before_destroy = true
  }
}

# ----------------------------------------------------------------------------
# IAM ROLE - Databricks Cross-Account
# ----------------------------------------------------------------------------
# IAM role that Databricks assumes to manage AWS resources

{{#unless cross_account_role_arn}}
# Cross-account role for Databricks
resource "aws_iam_role" "databricks_cross_account" {
  name               = "${var.project_prefix}-databricks-cross-account-role"
  assume_role_policy = data.databricks_aws_assume_role_policy.this.json
  
  tags = merge(var.common_tags, {
    Name = "${var.project_prefix}-databricks-cross-account-role"
  })
}

# Policy attached to the cross-account role
resource "aws_iam_role_policy" "databricks_cross_account" {
  name   = "${var.project_prefix}-databricks-cross-account-policy"
  role   = aws_iam_role.databricks_cross_account.id
  policy = data.databricks_aws_crossaccount_policy.this.json
}

# ----------------------------------------------------------------------------
# SELF-ASSUME ROLE (via AWS CLI)
# ----------------------------------------------------------------------------
# Databricks requires the role to assume itself (self-assume)

# Wait for IAM role propagation
resource "time_sleep" "wait_for_role" {
  depends_on = [
    aws_iam_role.databricks_cross_account,
    aws_iam_role_policy.databricks_cross_account
  ]
  
  create_duration = "10s"
}

# Update assume role policy to include self-assume
resource "null_resource" "configure_self_assume_role" {
  depends_on = [time_sleep.wait_for_role]
  
  provisioner "local-exec" {
    command = <<-EOT
      aws iam update-assume-role-policy \
        --role-name "${aws_iam_role.databricks_cross_account.name}" \
        --policy-document '{
          "Version": "2012-10-17",
          "Statement": [{
            "Effect": "Allow",
            "Principal": {
              "AWS": [
                "${aws_iam_role.databricks_cross_account.arn}",
                "arn:${data.aws_partition.current.partition}:iam::414351767826:root"
              ]
            },
            "Action": "sts:AssumeRole",
            "Condition": {
              "StringEquals": {
                "sts:ExternalId": "${var.databricks_account_id}"
              }
            }
          }]
        }'
    EOT
  }
  
  triggers = {
    role_arn              = aws_iam_role.databricks_cross_account.arn
    databricks_account_id = var.databricks_account_id
  }
}
{{/unless}}

# IAM role ARN to use (new or existing)
locals {
  databricks_role_arn = {{#if cross_account_role_arn}}var.cross_account_role_arn{{else}}aws_iam_role.databricks_cross_account.arn{{/if}}
}

# ----------------------------------------------------------------------------
# S3 BUCKET - Databricks Root Storage
# ----------------------------------------------------------------------------

# Root storage bucket for Databricks workspace data
resource "aws_s3_bucket" "databricks_root" {
  bucket        = "${var.project_prefix}-databricks-root-${data.aws_caller_identity.current.account_id}"
  force_destroy = true
  
  tags = merge(var.common_tags, {
    Name = "${var.project_prefix}-databricks-root"
  })
}

# Versioning disabled to reduce storage costs
resource "aws_s3_bucket_versioning" "databricks_root" {
  bucket = aws_s3_bucket.databricks_root.id
  
  versioning_configuration {
    status = "Disabled"
  }
}

# Enable encryption at rest
resource "aws_s3_bucket_server_side_encryption_configuration" "databricks_root" {
  bucket = aws_s3_bucket.databricks_root.id
  
  rule {
    apply_server_side_encryption_by_default {
      sse_algorithm = "AES256"
    }
  }
}

# Block all public access
resource "aws_s3_bucket_public_access_block" "databricks_root" {
  bucket = aws_s3_bucket.databricks_root.id
  
  block_public_acls       = true
  block_public_policy     = true
  ignore_public_acls      = true
  restrict_public_buckets = true
}

# Databricks-specific bucket policy
data "databricks_aws_bucket_policy" "this" {
  bucket = aws_s3_bucket.databricks_root.bucket
}

resource "aws_s3_bucket_policy" "databricks_root" {
  bucket = aws_s3_bucket.databricks_root.id
  policy = data.databricks_aws_bucket_policy.this.json
  
  depends_on = [aws_s3_bucket_public_access_block.databricks_root]
}

{{#if enable_private_link}}

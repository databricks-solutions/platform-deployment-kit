# Security group for PrivateLink VPC Endpoints
resource "aws_security_group" "privatelink" {
  name        = "${var.project_prefix}-privatelink-sg"
  description = "Security group for Databricks PrivateLink VPC Endpoints"
  vpc_id      = local.vpc_id
  
  # Allow HTTPS from VPC CIDR
  ingress {
    description = "Allow HTTPS from VPC"
    from_port   = 443
    to_port     = 443
    protocol    = "tcp"
    cidr_blocks = [var.vpc_cidr]
  }
  
  # Allow all outbound traffic
  egress {
    description = "Allow all outbound traffic"
    from_port   = 0
    to_port     = 0
    protocol    = "-1"
    cidr_blocks = ["0.0.0.0/0"]
  }
  
  tags = merge(var.common_tags, {
    Name = "${var.project_prefix}-privatelink-sg"
  })
}

# VPC Endpoint for Databricks Workspace (REST API)
resource "aws_vpc_endpoint" "workspace" {
  vpc_id              = local.vpc_id
  service_name        = local.privatelink_workspace_service[var.aws_region]
  vpc_endpoint_type   = "Interface"
  subnet_ids          = [local.privatelink_subnet_id]
  security_group_ids  = [aws_security_group.privatelink.id]
  private_dns_enabled = false
  
  tags = merge(var.common_tags, {
    Name = "${var.project_prefix}-workspace-vpce"
  })
}

# VPC Endpoint for Databricks Backend Relay (SCC Relay)
resource "aws_vpc_endpoint" "relay" {
  vpc_id              = local.vpc_id
  service_name        = local.privatelink_relay_service[var.aws_region]
  vpc_endpoint_type   = "Interface"
  subnet_ids          = [local.privatelink_subnet_id]
  security_group_ids  = [aws_security_group.privatelink.id]
  private_dns_enabled = false
  
  tags = merge(var.common_tags, {
    Name = "${var.project_prefix}-relay-vpce"
  })
}

# Register Workspace VPC Endpoint with Databricks
resource "databricks_mws_vpc_endpoint" "workspace" {
  provider            = databricks.mws
  account_id          = var.databricks_account_id
  vpc_endpoint_name   = "${var.project_prefix}-workspace-vpce"
  aws_vpc_endpoint_id = aws_vpc_endpoint.workspace.id
  region              = var.aws_region
}

# Register Backend Relay VPC Endpoint with Databricks
resource "databricks_mws_vpc_endpoint" "relay" {
  provider            = databricks.mws
  account_id          = var.databricks_account_id
  vpc_endpoint_name   = "${var.project_prefix}-relay-vpce"
  aws_vpc_endpoint_id = aws_vpc_endpoint.relay.id
  region              = var.aws_region
}

# Private Access Settings for the workspace
resource "databricks_mws_private_access_settings" "this" {
  provider                     = databricks.mws
  account_id                   = var.databricks_account_id
  private_access_settings_name = "${var.project_prefix}-pas"
  region                       = var.aws_region
  
  # Allow access from PrivateLink only
  public_access_enabled = false
  
  # Allow access from any VPC endpoint (not restricted to specific endpoints)
  private_access_level = "ACCOUNT"
}
{{/if}}

# ----------------------------------------------------------------------------
# DATABRICKS MWS CONFIGURATION
# ----------------------------------------------------------------------------

# Register IAM credentials with Databricks
resource "databricks_mws_credentials" "this" {
  provider         = databricks.mws
  credentials_name = "${var.project_prefix}-credentials"
  role_arn         = local.databricks_role_arn
  
  {{#unless cross_account_role_arn}}
  depends_on = [null_resource.configure_self_assume_role]
  {{/unless}}
}

# Register S3 bucket with Databricks
resource "databricks_mws_storage_configurations" "this" {
  provider                   = databricks.mws
  account_id                 = var.databricks_account_id
  storage_configuration_name = "${var.project_prefix}-storage"
  bucket_name                = aws_s3_bucket.databricks_root.bucket
  
  depends_on = [aws_s3_bucket_policy.databricks_root]
}

# Register VPC network with Databricks
# Network is registered when:
# - Creating a new VPC
# - Using an existing VPC with new subnets
# - Using an existing VPC with existing subnets
resource "databricks_mws_networks" "this" {
  count = var.create_new_vpc || var.create_new_subnets || length(var.existing_subnet_ids) > 0 ? 1 : 0
  
  provider     = databricks.mws
  account_id   = var.databricks_account_id
  network_name = "${var.project_prefix}-network"
  vpc_id             = local.vpc_id
  subnet_ids         = local.databricks_subnet_ids
  security_group_ids = local.security_group_ids
}

# ----------------------------------------------------------------------------
# DATABRICKS WORKSPACE
# ----------------------------------------------------------------------------

# Main Databricks workspace resource
resource "databricks_mws_workspaces" "this" {
  provider       = databricks.mws
  account_id     = var.databricks_account_id
  workspace_name = var.workspace_name
  deployment_name = var.workspace_name
  aws_region      = var.aws_region
  
  credentials_id           = databricks_mws_credentials.this.credentials_id
  storage_configuration_id = databricks_mws_storage_configurations.this.storage_configuration_id
  # Network ID is set when using custom network configuration
  network_id               = length(databricks_mws_networks.this) > 0 ? databricks_mws_networks.this[0].network_id : null
  
  {{#if enable_private_link}}
  # PrivateLink configuration
  private_access_settings_id = databricks_mws_private_access_settings.this.private_access_settings_id
  {{/if}}
  
  # Generate workspace token for API access
  token {
    comment = "Terraform provisioning token"
  }
  
  {{#if enable_private_link}}
  depends_on = [
    databricks_mws_vpc_endpoint.workspace,
    databricks_mws_vpc_endpoint.relay
  ]
  {{/if}}
}

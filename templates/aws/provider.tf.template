# ============================================================================
# AWS Provider Configuration
# ============================================================================
#
# PURPOSE:
#   This file configures the Terraform providers needed for AWS and Databricks.
#
# AUTHENTICATION:
#   AWS: Uses credentials in this order:
#     1. AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY environment variables
#     2. AWS credentials file (~/.aws/credentials)
#     3. IAM role (if running on EC2/ECS/Lambda)
#     4. AWS SSO credentials
#
#   Databricks: Uses credentials in this order:
#     1. DATABRICKS_HOST and DATABRICKS_TOKEN environment variables
#     2. Databricks CLI configuration (~/.databrickscfg)
# ============================================================================

# ----------------------------------------------------------------------------
# AWS PROVIDER
# ----------------------------------------------------------------------------
provider "aws" {
  region = var.aws_region
  
  default_tags {
    tags = var.common_tags
  }
}

# ----------------------------------------------------------------------------
# DATABRICKS PROVIDER - Account Level (MWS)
# ----------------------------------------------------------------------------
# Used for account-level operations: creating workspaces, credentials, networks
provider "databricks" {
  alias      = "mws"
  host       = "https://accounts.cloud.databricks.com"
  account_id = var.databricks_account_id
}

# ----------------------------------------------------------------------------
# DATABRICKS PROVIDER - Workspace Level
# ----------------------------------------------------------------------------
# Used for workspace-level operations after the workspace is created
provider "databricks" {
  alias = "workspace"
  host  = databricks_mws_workspaces.this.workspace_url
  token = databricks_mws_workspaces.this.token[0].token_value
}

# ============================================================================
# AWS Terraform Outputs
# ============================================================================
#
# PURPOSE:
#   This file defines output values displayed after Terraform applies.
#
# USAGE:
#   - View all outputs: terraform output
#   - View specific output: terraform output workspace_url
#   - Export as JSON: terraform output -json
# ============================================================================

# ----------------------------------------------------------------------------
# DATABRICKS WORKSPACE OUTPUTS
# ----------------------------------------------------------------------------

output "workspace_url" {
  description = "Databricks workspace URL"
  value       = databricks_mws_workspaces.this.workspace_url
}

output "workspace_id" {
  description = "Databricks workspace ID"
  value       = databricks_mws_workspaces.this.workspace_id
}

output "workspace_token" {
  description = "Databricks workspace token for API access"
  value       = databricks_mws_workspaces.this.token[0].token_value
  sensitive   = true
}

# ----------------------------------------------------------------------------
# NETWORKING OUTPUTS
# ----------------------------------------------------------------------------

output "vpc_id" {
  description = "VPC ID"
  value       = local.vpc_id
}

output "security_group_id" {
  description = "Security group ID for Databricks"
  value       = var.create_new_vpc ? aws_security_group.databricks[0].id : null
}

# ----------------------------------------------------------------------------
# IAM OUTPUTS
# ----------------------------------------------------------------------------

output "databricks_role_arn" {
  description = "ARN of the Databricks cross-account IAM role"
  value       = local.databricks_role_arn
}

# ----------------------------------------------------------------------------
# STORAGE OUTPUTS
# ----------------------------------------------------------------------------

output "databricks_root_bucket" {
  description = "S3 bucket name for Databricks root storage"
  value       = aws_s3_bucket.databricks_root.bucket
}

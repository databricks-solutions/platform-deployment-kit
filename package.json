{
  "name": "oneclick-databricks-deployer",
  "version": "1.0.0",
  "description": "Browser-based generator for deployable Databricks Terraform projects",
  "private": true,
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:debug": "playwright test --debug",
    "test:headed": "playwright test --headed",
    "test:coverage": "COVERAGE=true playwright test --config=playwright.coverage.config.js",
    "coverage": "npm run test:coverage",
    "start": "bash scripts/run.sh",
    "dev": "node scripts/dev.js",
    "build": "node scripts/build.js",
    "build:libs": "node scripts/copy-libs.js",
    "deploy": "bash scripts/deploy.sh",
    "postinstall": "npm run build:libs",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest"
  },
  "keywords": [
    "databricks",
    "terraform"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "@vitest/coverage-v8": "^4.1.2",
    "v8-to-istanbul": "^9.3.0",
    "vitest": "^4.1.2"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.2.8",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "bootstrap": "5.3.2",
    "bootstrap-icons": "1.11.1",
    "choices.js": "^10.2.0",
    "handlebars": "^4.7.8",
    "jszip": "3.10.1",
    "playwright": "^1.57.0"
  }
}
